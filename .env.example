# ── gb-crypto-hedging-service ─────────────────────────────────────────────
# Copy to .env. NEVER commit .env. Demo/paper venues only — mainnet is hard-blocked.

# HTTP control plane
PORT=8790

# Hedge symbol + loop cadence
SYMBOL=BTCUSDT
HEDGE_INTERVAL_SEC=10
# Floor on per-second vol used for the digital delta (cold-start guard).
MIN_SIGMA_PER_SEC=0.00004

# ── Inventory source (read-only) ──────────────────────────────────────────
# 'gamebull' = read the MMP LMSR inventory from predictor Redis (prod path).
# 'empty'    = no inventory (loop runs, hedges nothing) — for a bare boot.
INVENTORY_SOURCE=gamebull
PREDICTOR_REDIS_HOST=127.0.0.1
PREDICTOR_REDIS_PORT=6379
HEDGEABLE_FEED_IDS=3
MMP_LMSR_KEY_YES=MMP_LMSR_QUANTITY_YES_
MMP_LMSR_KEY_NO=MMP_LMSR_QUANTITY_NO_
MMP_MARKET_META_KEY=MMP_MARKET_META_
# Spot underlying (published by the local oracle-feed driver)
SPOT_REDIS_KEY=CRYPTO_SPOT_BTCUSDT

# ── Execution venue ───────────────────────────────────────────────────────
# 'dry-run'      = simulate fills, place no orders (Phase 0 default, no keys).
# 'binance-demo' = Binance USDⓈ-M DEMO/testnet perp (Phase 2).
EXECUTION_VENUE=dry-run
BINANCE_API_KEY=
BINANCE_API_SECRET=
FUTURES_BASE=https://demo-fapi.binance.com
HEDGE_LEVERAGE=1
MULTI_ASSETS_MARGIN=true

# ── Risk gate (same knobs as amm-hedging) ─────────────────────────────────
HEDGE_ENABLED=false
HEDGE_VOL_GATE=false
HEDGE_VOL_WINDOW=60
HEDGE_VOL_THRESHOLD=0.0002
HEDGE_VOL_HYSTERESIS=0.6
HEDGE_GATE_MODE=adaptive
HEDGE_GATE_PCTL=0.6
HEDGE_NOTIONAL_USDT=80
MAX_NOTIONAL_USDT=10000
HEDGE_DEADBAND_USDT=75
